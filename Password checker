s=input()
u=0
l=0
d=0
sp=0
if len(s)>=8:
    for i in s:
        if i.isupper():
            u+=1
        elif i.islower():
            l+=1
        elif i.isdigit():
            d+=1
        else:
            sp+=1
    if u>=1 and l>=1 and d>=1 and sp>=1:
        print("VALID PASSWORD")
    else:
        print("INVALID PASSWORD")
            
else:
    print("INVALID PASSWORD")
        
